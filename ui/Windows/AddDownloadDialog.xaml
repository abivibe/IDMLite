<Window x:Class="IDMLite.Windows.AddDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_AddDlgTitle}"
        Height="515" Width="660" MinWidth="580" MinHeight="480" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBgBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="12"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Dark Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="14,0,6,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,3 L12,15 M7,10.5 L12,15.5 L17,10.5"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="M4,17 L4,19.5 C4,20.3 4.7,21 5.5,21 L18.5,21 C19.3,21 20,20.3 20,19.5 L20,17"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{DynamicResource Str_AddDlgHeading}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{DynamicResource WindowControlButtonStyle}" Click="BtnWinMinimize_Click" ToolTip="Küçült">
                            <Path Data="M0,0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                        </Button>
                        <Button Style="{DynamicResource WindowCloseButtonStyle}" IsCancel="True" ToolTip="{DynamicResource Str_Cancel}">
                            <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Form Content -->
            <Grid Grid.Row="1" Margin="24,18,24,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Heading Banner -->
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="{DynamicResource Str_AddDlgHeading}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="{DynamicResource Str_AddDlgSubheading}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- URL Input -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="116"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_UrlAddress}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox x:Name="TxtUrl" AutomationProperties.Name="{DynamicResource Str_UrlAddress}" Grid.Column="1" Height="36"
                             TextChanged="TxtUrl_TextChanged"/>
                </Grid>

                <!-- Stream Selection (Video vs Audio) -->
                <Grid x:Name="PnlStreamSelection" Grid.Row="2" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="116"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_StreamFormat}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="RbStreamVideo" Content="{DynamicResource Str_VideoFormat}" IsChecked="True" Checked="RbStream_Checked" Margin="0,0,22,0"/>
                        <RadioButton x:Name="RbStreamAudio" Content="{DynamicResource Str_AudioFormat}" Checked="RbStream_Checked"/>
                    </StackPanel>
                </Grid>

                <!-- Category & Size -->
                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="116"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_Category}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="CmbCategory" AutomationProperties.Name="{DynamicResource Str_Category}" Grid.Column="1" Height="36"
                              SelectionChanged="CmbCategory_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource Str_Other}" Tag="Other"/>
                        <ComboBoxItem Content="{DynamicResource Str_Compressed}" Tag="Compressed"/>
                        <ComboBoxItem Content="{DynamicResource Str_Documents}" Tag="Documents"/>
                        <ComboBoxItem Content="{DynamicResource Str_Music}" Tag="Music"/>
                        <ComboBoxItem Content="{DynamicResource Str_Video}" Tag="Video"/>
                        <ComboBoxItem Content="{DynamicResource Str_Programs}" Tag="Programs"/>
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="{DynamicResource Str_Size}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,8,0" Foreground="{DynamicResource TextMutedBrush}"/>
                    <Border Grid.Column="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,0" Height="36" MinWidth="96">
                        <TextBlock x:Name="LblFileSize" Text="—" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </Grid>

                <!-- Save As / File Name -->
                <Grid Grid.Row="4" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="116"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_SaveFileName}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox x:Name="TxtFileName" AutomationProperties.Name="{DynamicResource Str_SaveFileName}" Grid.Column="1" Height="36"/>
                </Grid>

                <!-- Save Folder -->
                <Grid Grid.Row="5" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="116"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_SaveDirectory}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox x:Name="TxtDirectory" AutomationProperties.Name="{DynamicResource Str_SaveDirectory}" Grid.Column="1" Height="36"/>
                    <Button Grid.Column="2" Content="{DynamicResource Str_Browse}" Margin="8,0,0,0" Height="36" MinWidth="84" Click="BtnBrowse_Click"/>
                </Grid>

                <!-- Preview Notice -->
                <Border x:Name="PreviewNotice" Grid.Row="6" Visibility="Collapsed" VerticalAlignment="Top" Padding="12,9" CornerRadius="8"
                        Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,4,0,0">
                    <TextBlock x:Name="LblPreviewStatus" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite"/>
                </Border>
            </Grid>

            <!-- Action Buttons Footer -->
            <Border Grid.Row="2" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnDownloadNow" Style="{DynamicResource PrimaryAccentButtonStyle}" MinWidth="130" Height="36" Margin="0,0,10,0"
                            Click="BtnDownloadNow_Click" IsDefault="True">
                        <TextBlock Text="{DynamicResource Str_DownloadNow}" Foreground="{DynamicResource PrimaryActionTextBrush}" FontWeight="Bold"/>
                    </Button>
                    <Button x:Name="BtnDownloadLater" Content="{DynamicResource Str_DownloadLater}" MinWidth="130" Height="36" Margin="0,0,10,0"
                            Click="BtnDownloadLater_Click"/>
                    <Button Content="{DynamicResource Str_Cancel}" MinWidth="84" Height="36" IsCancel="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
