<Window x:Class="IDMLite.Windows.AddDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_AddDlgTitle}" 
        Height="510" Width="680" MinWidth="600" MinHeight="510" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBgBrush}">

    <Border Background="{DynamicResource WindowBgBrush}" Padding="24">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Icon -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
        <StackPanel Orientation="Horizontal">
            <Path IsHitTestVisible="False" Focusable="False" Data="M8,2 V11 M4,7 L8,11 12,7 M3,14 H13" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="21" Height="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Str_AddDlgHeading}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{DynamicResource Str_AddDlgSubheading}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>
        </Border>

        <!-- URL Input -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Str_UrlAddress}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextBrush}"/>
            <TextBox x:Name="TxtUrl" AutomationProperties.Name="{DynamicResource Str_UrlAddress}" Grid.Column="1" MinHeight="38" Padding="10,0" VerticalContentAlignment="Center"
                     TextChanged="TxtUrl_TextChanged" Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}"/>
        </Grid>

        <!-- Stream Selection (Video vs Audio) -->
        <Grid x:Name="PnlStreamSelection" Grid.Row="2" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Str_StreamFormat}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="RbStreamVideo" Content="{DynamicResource Str_VideoFormat}" IsChecked="True" Checked="RbStream_Checked" Margin="0,0,20,0" Foreground="{DynamicResource TextBrush}"/>
                <RadioButton x:Name="RbStreamAudio" Content="{DynamicResource Str_AudioFormat}" Checked="RbStream_Checked" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Category & Size -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Str_Category}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextBrush}"/>
            <ComboBox x:Name="CmbCategory" AutomationProperties.Name="{DynamicResource Str_Category}" Grid.Column="1" MinHeight="38" VerticalContentAlignment="Center" SelectionChanged="CmbCategory_SelectionChanged"
                      Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}">
                <ComboBoxItem Content="{DynamicResource Str_Other}" Tag="Other"/>
                <ComboBoxItem Content="{DynamicResource Str_Compressed}" Tag="Compressed"/>
                <ComboBoxItem Content="{DynamicResource Str_Documents}" Tag="Documents"/>
                <ComboBoxItem Content="{DynamicResource Str_Music}" Tag="Music"/>
                <ComboBoxItem Content="{DynamicResource Str_Video}" Tag="Video"/>
                <ComboBoxItem Content="{DynamicResource Str_Programs}" Tag="Programs"/>
            </ComboBox>

            <TextBlock Grid.Column="2" Text="{DynamicResource Str_Size}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="14,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="LblFileSize" Grid.Column="3" Text="—" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" MinWidth="105"/>
        </Grid>

        <!-- Save As / File Name -->
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Str_SaveFileName}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextBrush}"/>
            <TextBox x:Name="TxtFileName" AutomationProperties.Name="{DynamicResource Str_SaveFileName}" Grid.Column="1" MinHeight="38" Padding="10,0" VerticalContentAlignment="Center"
                     Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}"/>
        </Grid>

        <!-- Save Folder -->
        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Str_SaveDirectory}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextBrush}"/>
            <TextBox x:Name="TxtDirectory" AutomationProperties.Name="{DynamicResource Str_SaveDirectory}" Grid.Column="1" MinHeight="38" Padding="10,0" VerticalContentAlignment="Center"
                     Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}"/>
            <Button Grid.Column="2" Content="{DynamicResource Str_Browse}" Margin="8,0,0,0" MinHeight="38" Padding="12,4" MinWidth="85" Click="BtnBrowse_Click"
                    Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}"/>
        </Grid>

        <Border x:Name="PreviewNotice" Grid.Row="6" Visibility="Collapsed" VerticalAlignment="Top" Padding="12,8" CornerRadius="7"
                Background="{DynamicResource CardBgBrush}" Margin="0,0,0,4">
            <TextBlock x:Name="LblPreviewStatus" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite"/>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnDownloadNow" MinWidth="130" MinHeight="42" Padding="14,4" Margin="0,0,10,0" 
                    FontWeight="SemiBold" Click="BtnDownloadNow_Click" IsDefault="True"
                    Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}"><TextBlock Text="{DynamicResource Str_DownloadNow}" Foreground="{DynamicResource PrimaryActionTextBrush}"/></Button>
            <Button x:Name="BtnDownloadLater" Content="{DynamicResource Str_DownloadLater}" MinWidth="140" MinHeight="42" Padding="14,4" Margin="0,0,10,0" 
                    Click="BtnDownloadLater_Click" Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}"/>
            <Button Content="{DynamicResource Str_Cancel}" MinWidth="85" MinHeight="42" Padding="14,4" IsCancel="True"
                    Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>
