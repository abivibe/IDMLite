<UserControl x:Class="IDMLite.Windows.TorrentJob"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontSize="13" UseLayoutRounding="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 1. Top Info Box -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_SaveFileName}" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                <TextBlock x:Name="FileTitle" Grid.Row="0" Grid.Column="1" Text="Dosya" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Str_Status}" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                <TextBlock x:Name="Status" Grid.Row="1" Grid.Column="1" Text="İndiriliyor..." FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str_SaveDirectory}" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                <TextBlock x:Name="Destination" Grid.Row="2" Grid.Column="1" Text="" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2"/>
            </Grid>
        </Border>

        <!-- 2. Transfer Rates, Progress Bar & Checksum -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Str_Ratio}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="Ratio" Text="0 B / 0 B" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_TransferRate}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="Speed" Text="0.00 MB/s" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{DynamicResource Str_Eta}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="Eta" Text="--" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4">
                    <ProgressBar x:Name="Progress" Height="20" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock x:Name="Percent" Text="0 %" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                </Grid>

            </StackPanel>
        </Border>
        <TabControl Grid.Row="2">
            <TabItem Header="{DynamicResource Torrent_Files}">
                <DockPanel>
                    <TextBlock x:Name="Selection" DockPanel.Dock="Bottom" Margin="8,4"/>
                    <ListView x:Name="FileList" Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}"
                              BorderBrush="{DynamicResource BorderBrush}" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource Torrent_Select}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="Selection_Click" AutomationProperties.Name="{Binding Path}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource Str_ColFileName}" DisplayMemberBinding="{Binding Path}"/>
                                <GridViewColumn Header="{DynamicResource Str_ColSize}" DisplayMemberBinding="{Binding Size}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                </DockPanel>
            </TabItem>
            <TabItem x:Name="PeerTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Torrent_Peers}"/>
                        <TextBlock x:Name="PeerCount" Margin="6,0,0,0"/>
                    </StackPanel>
                </TabItem.Header>
                <DataGrid x:Name="PeerList" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Torrent_PeerClient}" Binding="{Binding Client}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Torrent_PeerAddress}" Binding="{Binding Address}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Str_ColSpeed}" Binding="{Binding Speed}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,12,0,0">
            <Button x:Name="FolderButton" Content="{DynamicResource Torrent_Folder}" Click="Folder_Click" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Torrent_Rate}" Click="Limit_Click" Padding="12,4"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource Torrent_Close}" Click="Close_Click" Padding="12,4"/>
            <Button DockPanel.Dock="Right" x:Name="ActionButton" Content="{DynamicResource Torrent_Start}"
                    Click="Action_Click" IsEnabled="False" Margin="0,0,8,0" Padding="12,4"
                    Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}"/>
        </DockPanel>
    </Grid>
</UserControl>
