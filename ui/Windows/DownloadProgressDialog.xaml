<Window x:Class="IDMLite.Windows.DownloadProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="13" UseLayoutRounding="True"
        Title="{DynamicResource Str_ProgDlgTitle}"
        Height="568" Width="695"
        MinHeight="360" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBgBrush}"
        MouseDoubleClick="Window_MouseDoubleClick">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="12"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="WinTaskbarInfo"/>
    </Window.TaskbarItemInfo>

    <Border x:Name="RootBorder"
            Background="{DynamicResource PanelBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- Custom Title Bar -->
                <RowDefinition Height="Auto"/> <!-- File Header Info -->
                <RowDefinition Height="Auto"/> <!-- Progress Summary -->
                <RowDefinition Height="*"/>    <!-- Segments Table -->
                <RowDefinition Height="Auto"/> <!-- Footer Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 0. Custom Dark Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="14,0,6,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,3 L12,15 M7,10.5 L12,15.5 L17,10.5"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="M4,17 L4,19.5 C4,20.3 4.7,21 5.5,21 L18.5,21 C19.3,21 20,20.3 20,19.5 L20,17"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{DynamicResource Str_ProgressShortTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{DynamicResource WindowControlButtonStyle}" Click="BtnWinMinimize_Click" ToolTip="Küçült">
                            <Path Data="M0,0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                        </Button>
                        <Button Style="{DynamicResource WindowControlButtonStyle}" Click="BtnWinMaximize_Click" ToolTip="Büyüt">
                            <Path x:Name="IconWinMaximize" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                        </Button>
                        <Button Style="{DynamicResource WindowCloseButtonStyle}" Click="BtnClose_Click" ToolTip="{DynamicResource Str_Close}">
                            <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. File Metadata Section -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- File Icon -->
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                            Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Margin="0,0,14,0" VerticalAlignment="Center">
                        <Image x:Name="ImgFileIcon" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Name, Status, Path -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFileName" Text="Dosya" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{DynamicResource Str_Status}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtStatus" Text="İndiriliyor..." FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{DynamicResource Str_LocationLabel}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtSavePath" Text="C:\Downloads" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Compact Action Pair (Open Folder + Collapse Segments) -->
                    <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="7" VerticalAlignment="Center" Margin="12,0,0,0" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{DynamicResource GhostButtonStyle}" Width="30" Height="28" Padding="0" Click="BtnOpenFolder_Click" ToolTip="{DynamicResource Str_ShowInFolder}">
                                <Path Width="13" Height="12" Stretch="Uniform"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                      Data="M1.5,3.5 H6 L7.5,5.5 H14.5 V12.5 H1.5 Z"/>
                            </Button>
                            <Button x:Name="BtnToggleSegments" Style="{DynamicResource GhostButtonStyle}" Width="30" Height="28" Padding="0" Click="BtnToggleSegments_Click" ToolTip="Parçaları Göster / Gizle">
                                <Path Width="9" Height="6" Stretch="Uniform"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M1,1 L4.5,4.5 L8,1" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SegmentsChevronRotate" Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. Progress Summary Section -->
            <Border Grid.Row="2" Padding="18,14,18,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Circular Status Badge -->
                        <Border x:Name="StatusBadgeCircle" Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                Background="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#2CE66B" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <Path x:Name="StatusBadgeIcon" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{DynamicResource PrimaryActionTextBrush}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M3,8.5 L6.8,12.2 L13.5,4.8"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Headline + Size Ratio + Speed/ETA -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeadlineStatus" Text="{DynamicResource Str_ProgressCompletedTitle}"
                                       FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="TxtSizeRatio" Text="0 B / 0 B" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtSpeedSep" Text="  •  " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtSpeed" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock x:Name="TxtEtaSep" Text="  •  " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtEta" Text="" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Large Emerald % Readout -->
                        <TextBlock x:Name="TxtPercent" Grid.Column="2" Text="%0" FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Thick Emerald Pill Progress Bar -->
                    <ProgressBar x:Name="PrgTotal" Height="10" Minimum="0" Maximum="100" Value="0">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border Background="{DynamicResource ProgressTrackBrush}" CornerRadius="5" ClipToBounds="True">
                                    <Grid x:Name="PART_Track">
                                        <Border x:Name="PART_Indicator" Background="{DynamicResource ProgressFillBrush}" HorizontalAlignment="Left" CornerRadius="5">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#2CE66B" BlurRadius="8" ShadowDepth="0" Opacity="0.45"/>
                                            </Border.Effect>
                                        </Border>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>

                    <!-- Optional SHA-256 Checksum Bar -->
                    <Border x:Name="PnlChecksum" Visibility="Collapsed" Margin="0,10,0,0"
                            Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="10,6">
                        <DockPanel>
                            <Button x:Name="BtnCopyChecksum" DockPanel.Dock="Right" Content="{DynamicResource Str_CopyChecksum}"
                                    Padding="10,3" FontSize="11" Click="BtnCopyChecksum_Click"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SHA-256: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtChecksum" Text="-" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,10,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. Multi-Thread Segments List (# | İlerleme | Boyut | Hız) -->
            <Grid x:Name="SegmentsSection" Grid.Row="3" Margin="18,2,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Segments Header Row -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,1" Padding="4,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Str_ColProgress}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                        <TextBlock Grid.Column="3" Text="{DynamicResource Str_ColSize}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                        <TextBlock Grid.Column="4" Text="{DynamicResource Str_ColSpeed}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Segments Rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <ItemsControl x:Name="LstSegments">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='#{0}'}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>

                                    <ProgressBar Grid.Column="1" Value="{Binding ProgressPercentage, Mode=OneWay}" Minimum="0" Maximum="100"
                                                 Height="7" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <TextBlock Grid.Column="2" Text="{Binding ProgressPercentage, StringFormat='%{0:0}'}" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3" Text="{Binding DownloadedMegabytesFormatted, Mode=OneWay}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="4" Text="{Binding SpeedMegabytesFormatted, Mode=OneWay}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 4. Bottom Action Footer Bar -->
            <Border Grid.Row="4" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="16,12" Background="{DynamicResource SidebarBgBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- Primary White/Contrast Button: Dosyayı Aç -->
                        <Button x:Name="BtnOpenFile" Style="{DynamicResource PrimaryLightButtonStyle}" Height="36" Padding="13,0" Margin="0,0,7,0" Click="BtnOpenFile_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="14" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                      Stroke="{DynamicResource PrimaryLightButtonTextBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                      Data="M1.5,3.5 H6 L7.5,5.5 H14.5 V12.5 H1.5 Z"/>
                                <TextBlock Text="{DynamicResource Str_OpenFile}" Foreground="{DynamicResource PrimaryLightButtonTextBrush}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Secondary: Klasörde Göster -->
                        <Button x:Name="BtnOpenFolder" Height="36" Padding="11,0" Margin="0,0,7,0" Click="BtnOpenFolder_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="14" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                      Data="M1.5,3.5 H6 L7.5,5.5 H14.5 V12.5 H1.5 Z"/>
                                <TextBlock Text="{DynamicResource Str_ShowInFolder}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Secondary: Hız Limiti -->
                        <Button Height="36" Padding="11,0" Margin="0,0,7,0" Click="BtnSpeedLimit_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round"
                                      Data="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 M8,1 V4 M8,12 V15 M1,8 H4 M12,8 H15"/>
                                <TextBlock Text="{DynamicResource Torrent_Rate}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Pause / Resume (shown while active/paused/error) -->
                        <Button x:Name="BtnPauseResume" Style="{DynamicResource PrimaryAccentButtonStyle}" Height="36" Padding="12,0" Margin="0,0,7,0" Click="BtnPauseResume_Click">
                            <TextBlock x:Name="TxtPauseResumeLabel" Text="{DynamicResource Str_PauseClean}" Foreground="{DynamicResource PrimaryActionTextBrush}" FontWeight="SemiBold" FontSize="12"/>
                        </Button>
                    </StackPanel>

                    <!-- Right: Ana Pencereye Gönder -->
                    <Button x:Name="BtnSendToMain" Grid.Column="2" Height="36" Padding="11,0" Click="BtnSendToMain_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M7,2 H2 V12 H12 V7 M8,1 H13 V6 M13,1 L6.5,7.5"/>
                            <TextBlock Text="{DynamicResource Str_SendToMainClean}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
