<Window x:Class="IDMLite.Windows.DownloadProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="13" UseLayoutRounding="True"
        Title="{DynamicResource Str_ProgDlgTitle}" 
        Height="510" Width="750"
        MinHeight="440" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBgBrush}"
        MouseDoubleClick="Window_MouseDoubleClick">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="WinTaskbarInfo"/>
    </Window.TaskbarItemInfo>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Info Box -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_SaveFileName}" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                <TextBlock x:Name="TxtFileName" Grid.Row="0" Grid.Column="1" Text="Dosya" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Str_Status}" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                <TextBlock x:Name="TxtStatus" Grid.Row="1" Grid.Column="1" Text="İndiriliyor..." FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str_SaveDirectory}" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                <TextBlock x:Name="TxtSavePath" Grid.Row="2" Grid.Column="1" Text="C:\Downloads" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2"/>
            </Grid>
        </Border>

        <!-- 2. Transfer Rates, Progress Bar & Checksum -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Str_Ratio}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtSizeRatio" Text="0 B / 0 B" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_TransferRate}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtSpeed" Text="0.00 MB/s" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{DynamicResource Str_Eta}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtEta" Text="--" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4">
                    <ProgressBar x:Name="PrgTotal" Height="20" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock x:Name="TxtPercent" Text="0 %" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                </Grid>

                <!-- Checksum Info -->
                <Grid x:Name="PnlChecksum" Visibility="Collapsed" Margin="0,6,0,0">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🛡️ SHA-256: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock x:Name="TxtChecksum" Text="-" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextBrush}" Margin="4,0,8,0"/>
                        </StackPanel>
                        <Button x:Name="BtnCopyChecksum" DockPanel.Dock="Right" Content="{DynamicResource Str_CopyChecksum}" Padding="8,2" FontSize="10" Click="BtnCopyChecksum_Click"
                                Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                    </DockPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Segment Header -->
        <TextBlock Grid.Row="2" Text="{DynamicResource Str_ConnectionSegments}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="2,0,0,6"/>

        <!-- 4. Multi-thread Segment Bars List -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LstSegments">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="95"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Segment Index -->
                                    <TextBlock Text="{Binding Index, StringFormat='#{0}'}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                    <!-- Segment Progress Bar -->
                                    <Grid Grid.Column="1" Margin="8,0">
                                        <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" Minimum="0" Maximum="100" Height="12" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:0.#}%'}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                    </Grid>

                                    <!-- Downloaded in chunk (MB) -->
                                    <TextBlock Grid.Column="2" Text="{Binding DownloadedMegabytesFormatted, Mode=OneWay}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                    <!-- Segment Speed (MB/s) -->
                                    <TextBlock Grid.Column="3" Text="{Binding SpeedMegabytesFormatted, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 5. Bottom Controls -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnOpenFile" Content="{DynamicResource Str_OpenFile}" MinWidth="105" Height="32" Padding="14,4" Margin="0,0,8,0" Click="BtnOpenFile_Click"
                        Background="{DynamicResource SuccessBrush}" Foreground="White" FontWeight="SemiBold"/>
                <Button x:Name="BtnOpenFolder" Content="{DynamicResource Str_ShowInFolder}" MinWidth="125" Height="32" Padding="14,4" Click="BtnOpenFolder_Click"
                        Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Move to Main Window Button -->
                <Button x:Name="BtnSendToMain" Content="{DynamicResource Str_SendToMain}" MinWidth="145" Height="32" Padding="14,4" Margin="0,0,8,0" Click="BtnSendToMain_Click"
                        Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}"/>

                <Button x:Name="BtnPauseResume" Content="Pause" MinWidth="105" Height="32" Padding="12,4" Margin="0,0,8,0" Click="BtnPauseResume_Click"
                        Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}" FontWeight="SemiBold"/>

                <Button x:Name="BtnClose" Content="{DynamicResource Str_Close}" MinWidth="80" Height="32" Padding="12,4" Click="BtnClose_Click"
                    Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
