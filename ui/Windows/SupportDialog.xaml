<Window x:Class="IDMLite.Windows.SupportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="13" UseLayoutRounding="True"
        Title="{DynamicResource Str_Support}"
        Height="290" Width="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="14,0,6,0">
                <Grid>
                    <TextBlock Text="{DynamicResource Str_Support}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Style="{DynamicResource WindowCloseButtonStyle}" IsCancel="True" Click="BtnClose_Click">
                        <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="20,18,20,14" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="♥" FontSize="30" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Buy Me a Coffee" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock HorizontalAlignment="Center" FontSize="14.5" FontWeight="SemiBold">
                        <Hyperlink x:Name="LnkBuyMeACoffee" NavigateUri="https://buymeacoffee.com/vibeabi" RequestNavigate="LnkBuyMeACoffee_RequestNavigate" Foreground="{DynamicResource AccentBrush}">
                            https://buymeacoffee.com/vibeabi
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                <Button x:Name="BtnClose" Style="{DynamicResource PrimaryAccentButtonStyle}" HorizontalAlignment="Right" Content="OK" Width="92" Height="34" IsDefault="True" IsCancel="True" Click="BtnClose_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
