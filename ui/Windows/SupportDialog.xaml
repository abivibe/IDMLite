<Window x:Class="IDMLite.Windows.SupportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="13" UseLayoutRounding="True"
        Title="{DynamicResource Str_Support}"
        Height="280" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="♥" FontSize="30" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Buy Me a Coffee" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold">
                    <Hyperlink x:Name="LnkBuyMeACoffee" NavigateUri="https://buymeacoffee.com/vibeabi" RequestNavigate="LnkBuyMeACoffee_RequestNavigate" Foreground="{DynamicResource AccentBrush}">
                        https://buymeacoffee.com/vibeabi
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnClose" Content="OK" Width="90" Height="32" IsDefault="True" IsCancel="True" Click="BtnClose_Click"
                    Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
        </StackPanel>
    </Grid>
</Window>
