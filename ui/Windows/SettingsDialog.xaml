<Window x:Class="IDMLite.Windows.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="13" UseLayoutRounding="True"
        Title="{DynamicResource Str_SettingsTitle}" 
        Height="580" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Background="{DynamicResource PanelBgBrush}">
            <!-- TAB 1: BAĞLANTI & HIZ -->
            <TabItem Header="{DynamicResource Str_TabConnection}">
                <StackPanel Margin="16">
                    <GroupBox Header="Bağlantı &amp; Segmentasyon Ayarları" Margin="0,0,0,16" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str_MaxThreads}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                <Slider x:Name="SldConnections" Grid.Column="1" Minimum="1" Maximum="32" Value="8" 
                                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="10,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SldConnections}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            </Grid>

                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str_MaxConcurrent}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                <Slider x:Name="SldConcurrent" Grid.Column="1" Minimum="1" Maximum="10" Value="3" 
                                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="10,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SldConcurrent}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource Str_TabSpeed}" Margin="0,0,0,16" Padding="12">
                        <StackPanel>
                            <CheckBox x:Name="ChkSpeedLimit" Content="{DynamicResource Str_EnableSpeedLimit}" Margin="0,0,0,10" 
                                      Checked="ChkSpeedLimit_Changed" Unchecked="ChkSpeedLimit_Changed" Foreground="{DynamicResource TextBrush}"/>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Maksimum Hız:" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                <TextBox x:Name="TxtSpeedLimitValue" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                         Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                                <ComboBox x:Name="CmbSpeedUnit" Grid.Column="2" Height="26" SelectedIndex="1"
                                          Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}">
                                    <ComboBoxItem Content="KB/s"/>
                                    <ComboBoxItem Content="MB/s"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Uygulama Davranışı" Padding="12">
                        <StackPanel>
                            <CheckBox x:Name="ChkCloseToTray" Content="{DynamicResource Str_CloseToTray}" Margin="0,4" Foreground="{DynamicResource TextBrush}"/>
                            <CheckBox x:Name="ChkNotification" Content="İndirme tamamlandığında Windows bildirimi göster" Margin="0,4" Foreground="{DynamicResource TextBrush}"/>
                            <CheckBox x:Name="ChkSound" Content="İndirme tamamlandığında ses çal" Margin="0,4" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- TAB 2: KAYIT KLASÖRLERİ -->
            <TabItem Header="{DynamicResource Str_TabFolders}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="İndirme kurtarma kayıtları (.idmlitemeta)" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextBrush}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtMetadataDirectory" Height="32" Padding="8,0" VerticalContentAlignment="Center" Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                            <Button Grid.Column="1" Content="{DynamicResource Str_Browse}" Margin="8,0,0,0" Height="32" Click="BtnBrowseDir_Click" Tag="Recovery" Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                        </Grid>
                        <CheckBox x:Name="ChkResumeInterrupted" Content="Yeniden açıldığında kesilen indirmelere devam et" Margin="0,0,0,16" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Kategoriye Özel Varsayılan Kayıt Klasörleri" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}"/>

                        <!-- General / Default -->
                        <TextBlock Text="{DynamicResource Str_AllDownloads}" FontWeight="Medium" Margin="0,4" Foreground="{DynamicResource TextBrush}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDirDefault" Height="32" Padding="8,0" VerticalContentAlignment="Center" Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                            <Button Grid.Column="1" Content="{DynamicResource Str_Browse}" Margin="8,0,0,0" Height="32" Padding="10,2" Click="BtnBrowseDir_Click" Tag="Default"
                                    Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                        </Grid>

                        <!-- Documents -->
                        <TextBlock Text="{DynamicResource Str_Documents}" FontWeight="Medium" Margin="0,4" Foreground="{DynamicResource TextBrush}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDirDocuments" Height="32" Padding="8,0" VerticalContentAlignment="Center" Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                            <Button Grid.Column="1" Content="{DynamicResource Str_Browse}" Margin="8,0,0,0" Height="32" Padding="10,2" Click="BtnBrowseDir_Click" Tag="Documents"
                                    Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                        </Grid>

                        <!-- Compressed -->
                        <TextBlock Text="{DynamicResource Str_Compressed}" FontWeight="Medium" Margin="0,4" Foreground="{DynamicResource TextBrush}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDirCompressed" Height="32" Padding="8,0" VerticalContentAlignment="Center" Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                            <Button Grid.Column="1" Content="{DynamicResource Str_Browse}" Margin="8,0,0,0" Height="32" Padding="10,2" Click="BtnBrowseDir_Click" Tag="Compressed"
                                    Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                        </Grid>

                        <!-- Music -->
                        <TextBlock Text="{DynamicResource Str_Music}" FontWeight="Medium" Margin="0,4" Foreground="{DynamicResource TextBrush}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDirMusic" Height="32" Padding="8,0" VerticalContentAlignment="Center" Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                            <Button Grid.Column="1" Content="{DynamicResource Str_Browse}" Margin="8,0,0,0" Height="32" Padding="10,2" Click="BtnBrowseDir_Click" Tag="Music"
                                    Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                        </Grid>

                        <!-- Video -->
                        <TextBlock Text="{DynamicResource Str_Video}" FontWeight="Medium" Margin="0,4" Foreground="{DynamicResource TextBrush}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDirVideo" Height="32" Padding="8,0" VerticalContentAlignment="Center" Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                            <Button Grid.Column="1" Content="{DynamicResource Str_Browse}" Margin="8,0,0,0" Height="32" Padding="10,2" Click="BtnBrowseDir_Click" Tag="Video"
                                    Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                        </Grid>

                        <!-- Programs -->
                        <TextBlock Text="{DynamicResource Str_Programs}" FontWeight="Medium" Margin="0,4" Foreground="{DynamicResource TextBrush}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDirPrograms" Height="32" Padding="8,0" VerticalContentAlignment="Center" Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                            <Button Grid.Column="1" Content="{DynamicResource Str_Browse}" Margin="8,0,0,0" Height="32" Padding="10,2" Click="BtnBrowseDir_Click" Tag="Programs"
                                    Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: TARAYICI ENTEGRASYONU -->
            <TabItem Header="{DynamicResource Str_Extension}">
                <StackPanel Margin="16">
                    <GroupBox Header="Yerel IPC Köprüsü (Desktop &lt;-&gt; Extension)" Margin="0,0,0,16" Padding="12">
                        <StackPanel>
                            <TextBlock Text="IDMLite arka planda yerel bir REST &amp; WebSocket sunucusu çalıştırır. Tarayıcı eklentisi bu port üzerinden indirmeleri aktarır." TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dinleme Portu:" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                <TextBox x:Name="TxtIpcPort" Grid.Column="1" Height="32" Padding="8,0" VerticalContentAlignment="Center" Text="41718"
                                         Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource Str_BrowserBridge}" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Native Messaging Host (Chrome / Edge / Firefox)" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Tarayıcıların eklentiyi yerel uygulama olarak doğrudan tanıması için Windows Kayıt Defteri (Registry) anahtarları yapılandırılır." TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Button Content="{DynamicResource Str_Extension}" Height="32" Padding="12,0" Click="BtnQuickExtension_Click"
                                        Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}" Margin="0,0,10,0"/>
                                <Button Content="Native Host'u Kaydet" Height="32" Padding="12,0" Click="BtnRegisterNativeHost_Click"
                                        Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0"/>
                                <Button Content="Eklenti Klasörünü Aç" Height="32" Padding="12,0" Click="BtnOpenExtensionFolder_Click"
                                        Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- TAB 4: DİL & GÖRÜNÜM -->
            <TabItem Header="🌐 Dil &amp; Görünüm">
                <StackPanel Margin="16">
                    <!-- Language Selection -->
                    <GroupBox Header="{DynamicResource Str_Language}" Margin="0,0,0,16" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Uygulama arayüz dilini anında değiştirebilirsiniz (Yeniden başlatma gerekmez):" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="CmbLanguage" Height="30" SelectionChanged="CmbLanguage_SelectionChanged"
                                      Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}" DisplayMemberPath="NativeName"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Theme Selection -->
                    <GroupBox Header="{DynamicResource Str_Theme}" Padding="12">
                        <StackPanel>
                            <RadioButton x:Name="RbThemeDark" Content="{DynamicResource Str_DarkAmoled}" GroupName="ThemeGroup" Margin="0,6" Checked="RbTheme_Checked" Foreground="{DynamicResource TextBrush}"/>
                            <RadioButton x:Name="RbThemeLight" Content="{DynamicResource Str_Light}" GroupName="ThemeGroup" Margin="0,6" Checked="RbTheme_Checked" Foreground="{DynamicResource TextBrush}"/>
                            <RadioButton x:Name="RbThemeSystem" Content="Windows Sistem Teması" GroupName="ThemeGroup" Margin="0,6" Checked="RbTheme_Checked" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Bottom OK / Cancel -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button MinWidth="130" Height="32" Padding="14,4" Margin="0,0,10,0" FontWeight="SemiBold"
                    Click="BtnSave_Click" IsDefault="True" Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}"><TextBlock Text="{DynamicResource Str_Save}" Foreground="{DynamicResource PrimaryActionTextBrush}"/></Button>
            <Button Content="{DynamicResource Str_Cancel}" MinWidth="85" Height="32" Padding="14,4" IsCancel="True"
                    Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>
    </Grid>
</Window>
