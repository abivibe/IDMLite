<Window x:Class="IDMLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:IDMLite.Models"
        Title="{DynamicResource Str_AppTitle}" 
        Height="704" Width="1120" FontSize="13" UseLayoutRounding="True"
        MinHeight="480" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="MainTaskbarInfo"/>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DownloadCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Main Menu -->
            <RowDefinition Height="Auto"/> <!-- Big IDM Toolbar -->
            <RowDefinition Height="*"/>    <!-- Split: Sidebar + DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top Menu -->
        <Menu Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource TextBrush}">
            <MenuItem Header="{DynamicResource Str_File}">
                <MenuItem Header="{DynamicResource Str_NewDownload}" InputGestureText="Ctrl+N" Click="MenuAdd_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Str_Exit}" InputGestureText="Alt+F4" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Str_Downloads}">
                <MenuItem Header="{DynamicResource Str_Resume}" Click="BtnResume_Click"/>
                <MenuItem Header="{DynamicResource Str_Pause}" Click="BtnPause_Click"/>
                <MenuItem Header="{DynamicResource Str_StopAll}" Click="BtnStopAll_Click"/>
                <MenuItem Header="{DynamicResource Str_ResumeAll}" Click="BtnResumeAll_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Str_Delete}" Click="BtnDelete_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Str_Tools}">
                <MenuItem Header="{DynamicResource Str_Extension}" Click="BtnExtension_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Str_Settings}" InputGestureText="Ctrl+O" Click="BtnSettings_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Str_Help}">
                <MenuItem Header="{DynamicResource Str_Support}" Click="BtnSupport_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Str_About}" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- 2. Classic Big Icon IDM Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource PrimaryActionBrush}">
                        <Path IsHitTestVisible="False" Focusable="False" Data="M8,2 V11 M4,7 L8,11 12,7 M3,14 H13" Stroke="{DynamicResource PrimaryActionTextBrush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="IDMLite" FontSize="24" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Str_AllDownloads}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                <!-- Add URL -->
                <Button Background="{DynamicResource PrimaryActionBrush}" Foreground="{DynamicResource PrimaryActionTextBrush}" Click="BtnAddUrl_Click" ToolTip="{DynamicResource Str_NewDownload}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <Path IsHitTestVisible="False" Focusable="False" Data="M8,2 V14 M2,8 H14" Stroke="{DynamicResource PrimaryActionTextBrush}" StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_AddUrl}" Foreground="{DynamicResource PrimaryActionTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Resume -->
                <Button Click="BtnResume_Click" ToolTip="{DynamicResource Str_Resume}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <Path IsHitTestVisible="False" Focusable="False" Data="M5,2 L13,8 5,14 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_Resume}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Pause -->
                <Button Click="BtnPause_Click" ToolTip="{DynamicResource Str_Pause}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <Path IsHitTestVisible="False" Focusable="False" Data="M5,2 V14 M11,2 V14" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_Pause}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Stop All -->
                <Button Click="BtnStopAll_Click" ToolTip="{DynamicResource Str_StopAll}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <Path IsHitTestVisible="False" Focusable="False" Data="M3,3 H13 V13 H3 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_StopAll}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Delete -->
                <Button Click="BtnDelete_Click" ToolTip="{DynamicResource Str_Delete}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <Path IsHitTestVisible="False" Focusable="False" Data="M2,4 H14 M4,4 L5,14 H11 L12,4 M6,4 V2 H10 V4" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_Delete}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Open Folder -->
                <Button Click="BtnOpenFolder_Click" ToolTip="{DynamicResource Str_ShowInFolder}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <Path IsHitTestVisible="False" Focusable="False" Data="M1,4 H6 L8,6 H15 L13,13 H1 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_ShowInFolder}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                <!-- Minimize to System Tray -->
                <Button Click="BtnTrayMinimize_Click" ToolTip="{DynamicResource Str_MinimizeToTray}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <Path IsHitTestVisible="False" Focusable="False" Data="M3,5 L8,10 13,5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_TrayMinimize}" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                <!-- Settings -->
                <Button Click="BtnSettings_Click" ToolTip="{DynamicResource Str_Settings}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <Path IsHitTestVisible="False" Focusable="False" Data="M3,4 H13 M3,8 H13 M3,12 H13 M6,2 V6 M10,6 V10 M6,10 V14" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_Tools}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Extension -->
                <Button Click="BtnExtension_Click" ToolTip="{DynamicResource Str_Extension}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <Path IsHitTestVisible="False" Focusable="False" Data="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 M1,8 H15 M8,1 V15" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_Extension}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 3. Main Workspace: Category Sidebar + Downloads Grid -->
        <Grid Grid.Row="2" Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="160" MaxWidth="350"/>
                <ColumnDefinition Width="4"/> <!-- GridSplitter -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Category Tree -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8,6">
                <DockPanel>
                    <TextBlock x:Name="LblCategoriesHeader" DockPanel.Dock="Top" Text="{DynamicResource Str_Categories}" FontWeight="Bold" FontSize="11" 
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,10,12,6"/>

                    <TreeView x:Name="TreeCategories" BorderThickness="0" Background="Transparent" 
                              SelectedItemChanged="TreeCategories_SelectedItemChanged" Margin="4,0">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource RowSelectedColor}"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource RowSelectedColor}"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource TextColor}"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource TextColor}"/>
                        </TreeView.Resources>
                        <TreeViewItem x:Name="TreeAll" Header="{DynamicResource Str_AllDownloads}" Tag="All" IsSelected="True" FontWeight="SemiBold">
                            <TreeViewItem x:Name="TreeUnfinished" Header="{DynamicResource Str_Unfinished}" Tag="Unfinished"/>
                            <TreeViewItem x:Name="TreeFinished" Header="{DynamicResource Str_Finished}" Tag="Finished"/>
                        </TreeViewItem>

                        <TreeViewItem x:Name="TreeTypes" Header="{DynamicResource Str_FileTypes}" Tag="Types" IsExpanded="True" FontWeight="SemiBold">
                            <TreeViewItem x:Name="TreeCompressed" Header="{DynamicResource Str_Compressed}" Tag="Compressed"/>
                            <TreeViewItem x:Name="TreeDocuments" Header="{DynamicResource Str_Documents}" Tag="Documents"/>
                            <TreeViewItem x:Name="TreeMusic" Header="{DynamicResource Str_Music}" Tag="Music"/>
                            <TreeViewItem x:Name="TreeVideo" Header="{DynamicResource Str_Video}" Tag="Video"/>
                            <TreeViewItem x:Name="TreePrograms" Header="{DynamicResource Str_Programs}" Tag="Programs"/>
                            <TreeViewItem x:Name="TreeOther" Header="{DynamicResource Str_Other}" Tag="Other"/>
                        </TreeViewItem>

                        <TreeViewItem x:Name="TreeQueues" Header="{DynamicResource Str_Queues}" Tag="Queues" IsExpanded="True" FontWeight="SemiBold">
                            <TreeViewItem x:Name="TreeMainQueue" Header="{DynamicResource Str_MainQueue}" Tag="MainQueue"/>
                        </TreeViewItem>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Right: Search Bar + DataGrid -->
            <Border Grid.Column="2" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBgBrush}">
            <Grid Margin="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search & Quick Filter Bar -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6" Background="{DynamicResource WindowBgBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="38" AutomationProperties.Name="{DynamicResource Str_SearchPlaceholder}" Padding="10,0" VerticalContentAlignment="Center" 
                                 TextChanged="TxtSearch_TextChanged" Foreground="{DynamicResource TextBrush}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush AlignmentX="Left" Stretch="None">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="{DynamicResource Str_SearchPlaceholder}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBlock x:Name="LblItemCount" Grid.Column="1" Text="0 dosya" VerticalAlignment="Center" Margin="12,0,4,0" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Virtualized IDM Downloads DataGrid -->
                <DataGrid x:Name="GridDownloads" Grid.Row="1" AutoGenerateColumns="False" 
                          RowHeight="38" ColumnHeaderHeight="34" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                          Background="{DynamicResource PanelBgBrush}" RowBackground="{DynamicResource PanelBgBrush}"
                          BorderThickness="0" HeadersVisibility="Column"
                          MouseDoubleClick="GridDownloads_MouseDoubleClick">

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource Str_OpenFile}" Click="ContextOpen_Click"/>
                            <MenuItem Header="{DynamicResource Str_ShowInFolder}" Click="ContextOpenFolder_Click"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource Str_Resume}" Click="BtnResume_Click"/>
                            <MenuItem Header="{DynamicResource Str_Pause}" Click="BtnPause_Click"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource Str_Details}" Click="ContextDetails_Click"/>
                            <MenuItem Header="{DynamicResource Str_VerifySha256}" Click="ContextVerifyChecksum_Click"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource Str_CopyUrl}" Click="ContextCopyUrl_Click"/>
                            <MenuItem Header="{DynamicResource Str_Delete}" Click="BtnDelete_Click"/>
                            <MenuItem Header="{DynamicResource Str_DeleteAll}" Click="ContextDeleteAll_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!-- File Name -->
                        <DataGridTemplateColumn Header="{DynamicResource Str_ColFileName}" Width="*" MinWidth="175" SortMemberPath="FileName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Image Source="{Binding FileIcon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBlock Text="{Binding FileName}" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Size -->
                        <DataGridTextColumn ElementStyle="{StaticResource DownloadCellText}" Header="{DynamicResource Str_ColSize}" Binding="{Binding TotalSizeFormatted}" Width="95" SortMemberPath="TotalSize"/>

                        <!-- Status -->
                        <DataGridTemplateColumn Header="{DynamicResource Str_ColStatus}" Width="140" SortMemberPath="StatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource CardBgBrush}">
                                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Progress Bar & % -->
                        <DataGridTemplateColumn Header="{DynamicResource Str_ColProgress}" Width="145" SortMemberPath="ProgressPercentage">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <ProgressBar Margin="0,0,48,0" Value="{Binding ProgressPercentage, Mode=OneWay}" Minimum="0" Maximum="100" Height="7" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:0.0}%'}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Speed -->
                        <DataGridTextColumn ElementStyle="{StaticResource DownloadCellText}" Header="{DynamicResource Str_ColSpeed}" Binding="{Binding SpeedFormatted}" Width="105"/>

                        <!-- Time Left (ETA) -->
                        <DataGridTextColumn ElementStyle="{StaticResource DownloadCellText}" Header="{DynamicResource Str_ColTimeLeft}" Binding="{Binding TimeRemainingFormatted}" Width="95"/>

                        <!-- Threads / Connections -->
                        <DataGridTextColumn ElementStyle="{StaticResource DownloadCellText}" Header="{DynamicResource Str_ColParts}" Binding="{Binding ConnectionCount, StringFormat='{}{0} th'}" Width="75"/>

                        <!-- Date Added -->
                        <DataGridTextColumn ElementStyle="{StaticResource DownloadCellText}" Header="{DynamicResource Str_ColDateAdded}" Binding="{Binding DateAddedFormatted}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            </Border>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LblTotalSpeed" Grid.Column="0" Text="⬇️ Toplam Hız: 0 KB/s" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock x:Name="LblActiveDownloads" Grid.Column="1" Text="Aktif: 0 | Toplam: 0" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock x:Name="LblIpcStatus" Grid.Column="2" Text="{DynamicResource Str_BrowserBridge}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="LblSpeedLimitStatus" Grid.Column="3" Text="⚡ Hız Sınırı: Sınırsız" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>

</Window>
